# ---------------------------------------------------------------- Unity --
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore .meta files — Unity needs them tracked.
!*.meta

# Asset meta data for files that no longer exist
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Autogenerated project files (regenerated by the IDE package)
/*.csproj
/*.unityproj
/*.sln
/*.suo
/*.tmp
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.mdb
/*.opendb
/*.VC.db
/.vs/
/.idea/
/.vscode/

# Unity crash reports
sysinfo.txt
/crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app

# ------------------------------------------------------------ .NET / CI --
# Headless self-test harness build output
bin/
[Bb]in/
[Oo]bj/

# ------------------------------------------------------------- macOS --
.DS_Store
