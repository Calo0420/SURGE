<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless MatchClock test harness.

    Compiles MatchClock straight out of Assets/ alongside Core/SurgeCore.cs,
    with no Unity involved. This works only because Surge.Timing.asmdef sets
    noEngineReferences — if this project ever stops building, the clock has
    grown a Unity dependency and is no longer testable without a licence.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Surge.Timing.Tests</AssemblyName>
    <RootNamespace>Surge.Ci</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Core/SurgeCore.cs" Link="SurgeCore.cs" />
    <Compile Include="../../Assets/Surge/Timing/MatchClock.cs" Link="MatchClock.cs" />
    <Compile Include="../../Assets/Surge/Timing/MatchClockSelfTest.cs"
             Link="MatchClockSelfTest.cs" />
  </ItemGroup>

</Project>
