<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless BoardGeometry harness.

    BoardGeometry replays MatchEngine.ApplyGravityAndRefill in order to tell a
    fallen node apart from a repaired one. That mirror is only safe if it is
    pinned against the real engine, which is what this project does — with no
    Unity involved, so it runs in CI without a licence.

    It compiles because BoardGeometry.cs contains no UnityEngine types. If this
    project ever stops building, that property has been lost and the diff is no
    longer testable outside the editor.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Surge.Board.Tests</AssemblyName>
    <RootNamespace>Surge.Ci</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Core/SurgeCore.cs" Link="SurgeCore.cs" />
    <Compile Include="../../Assets/Surge/Runtime/BoardGeometry.cs"
             Link="BoardGeometry.cs" />
  </ItemGroup>

</Project>
